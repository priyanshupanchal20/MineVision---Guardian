#pragma once
// Copy this file to secrets.h and fill in local credentials.
// secrets.h is gitignored.
//
// ESP32 and the Pi must join the SAME Wi-Fi (home / college / phone hotspot).
// Do NOT hardcode a Pi IP — use minevision.local so any DHCP address works.

#define WIFI_SSID     "Home"
#define WIFI_PASSWORD "YOUR_PASSWORD"

#define GATEWAY_HOST  "minevision.local"
#define GATEWAY_PORT  8000
#define VEHICLE_ID    "DUMPER_01"

// Optional extra networks (college lab, phone hotspot, judge venue, …)
#define WIFI_SSID_2     ""
#define WIFI_PASSWORD_2 ""
#define WIFI_SSID_3     ""
#define WIFI_PASSWORD_3 ""
